<Row ss:Height="30"><Cell ss:StyleID="Header"><Data ss:Type="String">用例ID</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">优先级</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">归属范围</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">模块/页面</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">测试场景</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">前置条件</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">测试数据</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">操作步骤</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">预期结果</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">通过/失败判定</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">建议执行方式</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">备注</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-001</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 浏览器主流程</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">登录 / 平台壳</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">有效账号登录后进入工作台</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">后端和前端均已启动；用户 A 已存在且有项目权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A：tester_a；密码按本地测试账号配置</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开前端地址；2. 输入用户 A 账号密码；3. 点击登录；4. 观察跳转和页面壳</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">登录成功，进入工作台；顶部模块、侧边栏、页面标题正常展示；无整页刷新循环。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">URL 进入业务页且控制台无关键红错为通过；登录后白屏、401 循环或整页刷新为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工 + 控制台观察</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">作为后续所有浏览器回归前置</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-002</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 浏览器主流程</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">平台导航</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">顶部模块和侧边栏连续切换不刷新</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 已登录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口自动化、Web 自动化、App 自动化、测试设计等模块</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 从工作台进入接口自动化；2. 快速点击请求历史、测试套件、接口测试用例；3. 切到 Web 自动化再切回接口自动化；4. 观察最终页面</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">最终停在最后一次点击目标；顶部模块、侧栏高亮、正文标题一致；无 beforeunload/pagehide 主文档刷新。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">最终目标一致且控制台无 navigation / dynamic import 红错为通过；页面卡住或刷新后才正常为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工，可用 Playwright 记录 beforeunload</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖平台壳稳定性</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-003</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 请求入口收口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">数据工厂列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">数据工厂列表加载和筛选</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 已登录；存在至少 2 条数据工厂记录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">关键词：已存在数据名称；状态筛选按页面实际选项</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 进入数据工厂页面；2. 观察列表请求；3. 输入关键词查询；4. 点击重置</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">列表正常加载；查询只展示匹配数据；重置恢复默认列表；请求带鉴权并走统一接口。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">页面展示和网络请求成功为通过；接口 401、500、无提示空白或控制台未捕获异常为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工 + Network 检查</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖 DataFactory.vue 请求收口</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-004</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 请求入口收口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">数据工厂选择器</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">业务弹窗中选择数据工厂记录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在会调用 DataFactorySelector 的业务入口；用户 A 已登录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 下的数据工厂记录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开含数据工厂选择器的弹窗或配置入口；2. 展开选择器；3. 搜索并选择一条记录；4. 保存或确认</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">选择器能加载数据、搜索、选中并回填；关闭后主表单状态正确。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">选中值正确回填为通过；下拉无数据、请求报错未提示或保存丢失为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖 DataFactorySelector.vue 请求收口</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-005</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 请求入口收口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">执行详情页</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">查看已有执行详情</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 有一条可访问执行记录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">execution_id：用户 A 自己的执行记录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 从执行记录列表进入详情；2. 查看基础信息、日志、结果摘要；3. 刷新页面后再次进入</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">详情数据正常展示；刷新后仍可加载；失败信息有清晰提示。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">详情内容和后端一致为通过；白屏、字段错位、无权限误判为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖 ExecutionDetailView.vue 请求收口</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-006</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 权限基线</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">需求分析配置检查接口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">未登录访问需求分析配置状态</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">清空登录态或使用无 token 浏览器窗口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">/api/requirement-analysis/config/check/ 或当前实际配置检查接口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 退出登录或新建无痕窗口；2. 直接访问配置检查接口；3. 观察响应</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">返回 401 或未认证错误；不返回真实配置状态。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">401/403 为通过；200 且返回配置内容为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口请求 + 浏览器 Network</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">敏感配置不能公开</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-007</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 权限基线</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">需求分析生成接口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">未登录不能创建 AI 生成任务</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">无登录态</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任意需求文本或文件</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 清空 token；2. 调用创建生成任务接口；3. 观察响应和数据库</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">返回 401/403；不会创建任务记录。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">无任务入库且接口失败为通过；匿名能创建任务为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口请求</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖 AI 生成入口权限</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-008</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 权限基线</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">需求生成进度接口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">未登录访问任务进度</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在用户 A 的生成任务 task_id；当前请求无登录态</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">task_id：用户 A 的任务</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 无登录态调用 progress 接口；2. 无登录态调用 stream_progress 接口；3. 观察响应</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">两个接口都返回 401/403，不因知道 task_id 就可读取进度。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">未认证失败为通过；返回任务进度、状态或结果为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口请求</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖 task_id 不能当安全凭证</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-009</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 EventSource</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">需求生成 SSE 进度</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器登录态下 EventSource 能携带凭据并收到进度</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 已登录；存在可触发生成的项目和配置</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">短需求文本，生成 1-2 条用例即可</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 在需求分析页发起生成；2. 打开 Network 查看 SSE 请求；3. 等待进度推送；4. 观察任务终态</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">SSE 请求携带有效登录凭据；进度正常更新；任务到达 completed/failed/cancelled 等终态后停止轮询。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">进度能更新且无 401 循环为通过；浏览器端 SSE 无凭据导致一直失败为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工 + Network</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">补 P0.1 未验证项</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-010</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 对象权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">跨用户需求任务</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 B 不能查看用户 A 的生成任务进度</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 和用户 B 属于不同项目权限；存在用户 A 的 task_id</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">task_id：用户 A 的任务；登录态：用户 B</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 使用用户 B 登录；2. 调用用户 A task_id 的 progress 接口；3. 打开可能的任务详情 URL</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口返回 403 或 404；页面显示无权限或不存在；不泄露任务内容。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">403/404 且无数据泄露为通过；返回任务进度、生成内容或项目信息为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口 + 浏览器</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">补真实无权限对象 403</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-011</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 App 报告权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">App 自动化报告</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 访问自己的真实 App 报告文件</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在用户 A 的 App 执行记录和真实报告文件目录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">execution_id：用户 A；报告文件 index.html 或可访问入口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 用户 A 登录；2. 从 App 执行记录进入报告；3. 打开报告详情或文件入口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 可正常打开自己的报告；返回 200；页面展示报告内容。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">200 且报告内容可见为通过；误报 403/404 或空白为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工 + Network</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">补真实 App 报告 200 未验证项</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-012</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 App 报告权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">App 自动化报告</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 B 不能访问用户 A 的 App 报告</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 有真实报告；用户 B 无该项目权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 的报告 URL；登录态：用户 B</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 复制用户 A 报告 URL；2. 切换用户 B 登录；3. 访问该 URL</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">返回 403 或无权限页；不泄露报告 HTML、截图、日志或附件。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">403/无权限为通过；能看到报告内容或下载附件为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工 + Network</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">补真实无权限对象 403</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-013</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 App 报告权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">media 直连报告</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">匿名直连 media 报告文件被拒绝</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在真实报告文件路径</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">/media/app-automation/allure-reports/.../index.html</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 退出登录或无痕窗口；2. 直接访问报告 media 路径；3. 观察响应</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">返回 403 或被安全入口拦截；不直接返回报告 HTML。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">403 为通过；匿名 200 打开报告为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器/接口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖 backend/urls.py 报告静态目录收口</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-014</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 认证一致性</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 profile</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">匿名访问 profile 被拒绝，登录后正常</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 存在</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">/api/auth/profile/ 或当前 profile 接口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 匿名请求 profile；2. 用户 A 登录后请求 profile；3. 对比响应</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">匿名返回 401；登录后返回用户 A 基础信息。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">匿名 401 且登录 200 为通过；匿名返回用户信息为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口请求</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖认证入口回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-015</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 认证一致性</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">退出登录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">匿名 logout 被拒绝，登录 logout 正常</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 存在</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">logout 接口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 匿名调用 logout；2. 用户 A 登录后调用 logout；3. 再访问 profile</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">匿名 logout 返回 401；登录 logout 成功；后续 profile 需要重新认证。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">认证状态按预期变化为通过；匿名退出成功或退出后仍能访问 profile 为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口 + 浏览器</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖 P0.1 剩余闭环</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-016</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 临时 token 清理</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">注册 / 测试注册</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">注册接口不返回 temp_token</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">允许注册或测试注册接口可用</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">新用户名：reg_p01_sample_时间戳</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 调用注册或测试注册接口；2. 查看响应字段；3. 使用 access 请求 profile</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">响应返回 JWT access/refresh；不返回 temp_token_*；access 可访问 profile。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">只有 JWT 双 token 为通过；出现 temp_token_* 为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口请求</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖假 token 清理</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-017</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 模拟实现清理</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">UI 自动化元素验证</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">未接入真实浏览器环境时不显示验证通过</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">UI 自动化元素管理页存在一条元素定位器；真实浏览器验证环境未接入或故意不可用</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任意元素定位器</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 进入元素管理页；2. 点击定位器验证；3. 观察接口响应和页面提示</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">返回 501 或明确未实现错误；页面展示真实错误原因，不显示绿色通过。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">明确失败/未实现为通过；没有真实验证却显示通过、生成假截图为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工 + Network</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">不能恢复模拟成功</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-018</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0.1 假入口清理</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">UI 自动化页面树</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">页面名称编辑未接入保存接口时明确提示不落库</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">页面树有可编辑页面节点</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">新页面名称：P01_name_not_saved</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 点击页面名称编辑；2. 输入新名称并确认；3. 刷新页面；4. 观察名称</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">页面明确提示当前不会保存或未接入保存接口；刷新后名称不应被误认为已保存。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">有明确提示为通过；静默关闭导致用户误以为保存成功为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖假成功清理</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-019</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口测试用例列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口测试用例列表字段完整</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 下有接口集合和接口用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">ApiRequest：GET /health 或本地样例接口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 进入接口自动化 &gt; 接口测试用例；2. 查看表格列；3. 使用项目、集合、方法、关键词筛选</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">表格包含用例名称、方法、URL、所属项目、所属集合、断言数、来源、最近执行状态、更新时间、操作；筛选正常。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">字段和筛选符合口径为通过；缺关键字段或筛选错乱为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 浏览器回归入口</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-020</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口测试用例列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">移动接口用例到同项目其他集合</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 下有集合 A1、A2；用例在 A1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">目标集合：A2</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 选中 A1 中的一条接口用例；2. 点击移动集合；3. 选择 A2 并确认；4. 刷新列表并按集合筛选</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">移动成功；用例出现在 A2；A1 不再包含该用例；页面有明确成功反馈。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">数据库和页面归属一致为通过；只前端变化、刷新后恢复或无反馈为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工 + 数据库/接口复核</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">重点回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-021</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口测试用例列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">不能移动到不同项目集合</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 用例；项目 B 集合；用户 A 对项目 B 无权限或不同项目</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">目标集合：项目 B 的集合</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开移动集合弹窗；2. 尝试选择或传入项目 B 集合；3. 点击确认</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">前端不展示跨项目集合；后端即使收到跨项目集合 ID 也返回 400/403；原用例集合不变。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">跨项目被阻断为通过；成功移动到别的项目为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 接口构造异常参数</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">对象权限边界</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-022</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口测试用例列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">移动到当前相同集合被阻断</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口用例在集合 A1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">目标集合：A1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 点击移动集合；2. 选择当前集合或不变更；3. 点击确认</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">页面提示目标集合不能与当前集合相同或禁用确认；后端不产生无意义更新。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阻断清晰为通过；提示成功但数据无变化为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">防假成功</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-023</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">请求历史</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">按当前筛选范围清空请求历史</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 至少有多条请求历史，覆盖不同方法/状态/关键词</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">筛选条件：项目 A + GET + 成功</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 进入请求历史；2. 设置筛选条件；3. 记录当前筛选数量和范围外数量；4. 点击清空历史并确认；5. 刷新列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">只清空当前筛选范围内记录；范围外历史保留；成功提示包含删除数量或范围说明。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">删除范围准确为通过；全量误删或只清空前端列表为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 数据库/接口复核</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">重点回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-024</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">请求历史</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">取消清空历史不改变数据</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">请求历史存在数据</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任意筛选条件</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 点击清空历史；2. 在确认弹窗点击取消；3. 刷新页面</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">历史记录数量不变；无成功删除提示。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">数据不变为通过；取消后仍删除为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">删除类确认回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-025</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">请求历史</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">无权限用户不能清空他人历史</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 有请求历史；用户 B 无项目 A 权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 B 登录，构造项目 A 筛选参数</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 用户 B 登录；2. 调用清空历史接口，传项目 A 或历史范围参数；3. 用户 A 登录复查历史</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 B 请求返回 403/空范围；用户 A 历史不被删除。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">他人数据未删为通过；用户 B 可删除用户 A 历史为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口请求 + 浏览器复核</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">权限高风险</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-026</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">测试套件</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">编辑并保存套件级断言</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 有测试套件，套件内含接口用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">套件级断言：状态码等于 201，和接口自身断言不同</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 进入测试套件；2. 打开某条套件请求的断言编辑弹窗；3. 修改断言并保存；4. 关闭后重新打开弹窗</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">保存成功；重新打开能回显套件级断言；不会改写接口用例自身断言。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">回显和对象边界正确为通过；刷新后丢失或改了接口自身断言为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 接口/数据库复核</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">重点回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-027</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">测试套件执行</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">套件执行优先使用套件级断言</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口自身断言和套件级断言不同；目标接口响应可稳定控制</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口自身断言：200；套件级断言：201 或相反</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 保存套件级断言；2. 执行测试套件；3. 查看执行结果和断言明细</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">执行结果使用套件级断言判断；断言明细展示套件级规则。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">结果符合套件级断言为通过；仍使用接口自身断言为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 执行结果详情</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">验证保存和执行链路都闭环</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-028</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">测试套件执行</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">清空套件级断言后回退接口自身断言</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">已存在套件级断言；接口自身断言有效</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">清空套件级断言</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开断言编辑弹窗；2. 清空套件级断言并保存；3. 执行测试套件；4. 查看断言明细</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">执行时回退使用接口自身断言；旧套件兼容。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">按接口自身断言判断为通过；无断言或仍用旧套件断言为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">兼容性回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-029</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">测试套件</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">断言编辑接口失败时不显示假成功</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">可临时断网或构造后端 400</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">非法断言结构</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开断言编辑弹窗；2. 输入非法断言或模拟接口失败；3. 点击保存</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">页面展示明确失败原因；弹窗或当前数据不被清空；刷新后旧断言仍在。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">失败不改变数据为通过；提示成功但未保存或清空旧断言为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + Network mock/接口构造</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">关键动作反馈闭环</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-030</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">删除风险提示</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">删除项目/集合/接口用例前显示级联风险</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在有关联数据的项目、集合、接口用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">有关联请求历史或套件引用的接口用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 在对应列表点击删除；2. 阅读确认弹窗；3. 点击取消；4. 再对可删除样本执行确认删除</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">确认文案说明会影响的关联对象；取消不删除；确认后真实删除并刷新列表。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">风险提示清晰且数据变化符合操作为通过；无提示直接删或取消仍删除为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">删除类 P0 回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-031</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口测试用例工作区</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">从列表进入隐藏调试工作区并带 projectId</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 有接口用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">caseId + projectId</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 在接口测试用例列表点击编辑/调试；2. 观察 URL query；3. 修改请求并保存；4. 点击返回用例列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">URL 携带 caseId 和 projectId；工作区加载目标用例；保存成功；可返回列表。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">加载和返回正常为通过；进入旧接口管理首页或项目上下文丢失为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0-1.5/阶段 A 兼容回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-032</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口测试用例列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">加入测试套件主流程</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 有接口用例和测试套件</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">选择同项目测试套件</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 在接口测试用例列表点击加入套件；2. 选择同项目套件；3. 确认；4. 打开测试套件查看</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">加入成功，有明确弹窗反馈；测试套件中可看到该接口用例。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">真实加入并可查回为通过；只有提示但套件无数据为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">闭环动作反馈</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-033</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口测试用例列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">无可用套件时加入套件给出阻断原因</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 C 有接口用例但没有测试套件</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 C 接口用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开项目 C 接口用例列表；2. 点击加入套件；3. 观察弹窗和按钮状态</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">明确提示当前项目没有可用测试套件；确认按钮禁用或无法提交。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阻断原因明确为通过；点击无反应或一直 loading 为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">关键动作不能静默失败</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-034</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 生成结果批次页</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">生成结果页支持单条采纳</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在 completed 任务，至少 1 条 pending 结果，绑定项目</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任务 T1，结果 R1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 从任务详情进入处理生成结果；2. 打开处理抽屉；3. 点击 R1 采纳；4. 查看正式测试用例入口</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">R1 状态变为 adopted；正式测试用例创建或幂等返回；可跳转正式资产。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">状态和正式资产一致为通过；点击无响应或保存失败无原因为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 后端样本任务</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">补用户当前痛点回归</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-035</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 生成结果批次页</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">生成结果页支持多选采纳</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在 completed 任务，至少 3 条 pending 结果</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">选择 R1、R2</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开处理抽屉；2. 勾选两条 pending 结果；3. 点击采纳选中；4. 刷新任务状态</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">所选结果变为 adopted；未选择结果仍 pending；任务处理状态摘要正确。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">只处理选中项为通过；全量误采纳或状态不刷新为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 后端样本任务</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖多选</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-036</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 生成结果批次页</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">生成结果页支持单条和批量不通过/弃用</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在至少 3 条 pending 结果</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">R1 单条弃用；R2/R3 批量弃用</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 对 R1 点击不通过；2. 勾选 R2/R3；3. 点击弃用选中；4. 刷新页面</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">对应结果状态为 discarded；原始结果保留；不能再勾选或采纳 discarded 行。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">状态为 discarded 且不物理删除为通过；删除原始结果或仍可采纳为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 接口复核</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户提到删除/不通过统一按弃用</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-037</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 生成完成页</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">生成完成后主按钮采纳全部待处理结果</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任务 completed，存在 pending 结果，项目归属有效</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任务 T2</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 生成完成后点击采纳全部待处理结果；2. 等待 loading 结束；3. 查看结果状态和正式测试用例列表</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">所有 pending 结果被采纳；按钮防重复点击；成功后有清晰反馈；正式资产可查。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">采纳成功并状态一致为通过；首次点击保存失败/无响应为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 后端样本任务</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖保存按钮问题</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-038</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 生成完成页</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">缺少项目归属时采纳全部被前端阻断</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在无项目归属或项目缺失的生成任务</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任务 T3 project_id 为空或无效</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开任务完成页；2. 点击采纳全部待处理结果；3. 观察提示和网络请求</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">前端提示缺少项目归属，需要先绑定/选择项目；不发起会落到默认项目的错误请求。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">明确阻断为通过；静默落入默认项目或后端报错无说明为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器手工</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">防错误归属</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-039</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 生成结果批次页</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">编辑生成结果并保存回 final_test_cases</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">存在 pending 结果</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">修改标题、前置条件、步骤、预期结果</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 打开处理抽屉；2. 编辑一条 pending 结果；3. 保存编辑；4. 刷新页面后再次查看</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">编辑内容保存并回显；后续采纳使用编辑后的内容。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">刷新后仍保留编辑内容为通过；只前端临时变更为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器 + 接口复核</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖编辑保存</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">REG-P01-040</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 自动评审</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">生成结果非空时自动评审不再报待评审用例为空</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">生成阶段真实写入 generated_test_cases/final_test_cases 非空</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任务 T4，至少 2 条生成用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">1. 触发自动评审；2. 查看评审请求内容和评审记录；3. 查看失败时提示</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">评审输入包含待评审用例；成功生成评审记录，失败时说明模型/配置原因而不是误报空用例。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">非空用例进入评审为通过；生成结果非空仍报空用例为失败。</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">接口/浏览器结合</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">当前记忆中仍需单独验证</Data></Cell></Row>
</Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet>

<Worksheet ss:Name="测试数据准备"><Table>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Row ss:Height="30"><Cell ss:StyleID="Header"><Data ss:Type="String">数据项</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">用途</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">准备要求</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">备注</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">正常权限用户</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">拥有项目 A、接口自动化项目 A、App 执行记录 A 的访问权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用于主流程和自己的资源访问</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 B</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">无权限用户</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">不拥有项目 A 权限，可拥有项目 B</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用于 403 / 数据隔离验证</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">主测试项目</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">包含需求分析任务、测试用例、接口自动化项目、App 执行记录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 A 可访问</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 B</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">隔离项目</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用户 B 可访问，用户 A 可按需要无权限</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用于跨项目访问验证</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 生成任务 T1/T2</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">状态 completed，final_test_cases 至少 3 条 pending，绑定项目 A</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖单条、多选、全部采纳和弃用</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 生成任务 T3</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">缺项目归属阻断</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">无 project_id 或 project_id 无效，包含 pending 结果</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">不能落入默认项目</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">App 执行记录 A</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">报告 200/403</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">有真实报告文件和数据库执行记录，归属项目 A / 用户 A</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">补 P0.1 未验证项</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">接口自动化集合 A1/A2</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">移动集合</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">同属接口项目 A；A1 中有接口用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖同项目移动</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">接口自动化集合 B1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">跨项目阻断</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">归属接口项目 B</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">后端必须阻断跨项目移动</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">测试套件 S1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">套件级断言</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 下套件，包含至少 1 条接口用例</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">保存、回显、执行优先级</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">请求历史样本</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">清空历史范围</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">覆盖不同项目、方法、状态、关键词，数量至少 10 条</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">用于验证只清空当前筛选范围</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">数据工厂记录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">请求入口回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">项目 A 下至少 2 条可查询记录</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">列表、搜索、选择器</Data></Cell></Row>
</Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet>

<Worksheet ss:Name="执行顺序"><Table>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Column ss:AutoFitWidth="0" ss:Width="130"/>
<Row ss:Height="30"><Cell ss:StyleID="Header"><Data ss:Type="String">顺序</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">阶段</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">执行动作</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">通过标准</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">证据</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">1</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">环境准备</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">启动后端、前端和必要执行服务；确认登录、接口代理、数据库连接正常</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">前端可登录，后端健康接口或首页无 500</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">启动日志、浏览器截图</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">2</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">测试数据准备</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">准备用户 A/B、项目 A/B、AI 生成任务、App 报告、接口自动化集合/套件/历史</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">测试数据可按测试数据准备表查到</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">数据库截图或管理后台截图</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">3</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0 浏览器主流程</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">执行 REG-P01-001 到 REG-P01-018</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">无白屏、无整页刷新、敏感接口权限正确</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">浏览器截图、Network、接口响应</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">4</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">阶段 A 接口自动化</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">执行 REG-P01-019 到 REG-P01-033</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">移动集合、清空历史、套件级断言均可刷新查回</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">页面截图、数据库或接口复核</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">5</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">AI 结果处理回归</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">执行 REG-P01-034 到 REG-P01-040</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">采纳、弃用、编辑保存、保存按钮反馈闭环</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">任务页截图、正式测试用例列表、接口响应</Data></Cell></Row>
<Row ss:AutoFitHeight="1"><Cell ss:StyleID="Cell"><Data ss:Type="String">6</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">收尾判定</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">汇总失败项，区分阻断、一般缺陷和环境问题</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">P0 阻断为 0；P1/P2 有明确缺陷编号和处理建议</Data></Cell><Cell ss:StyleID="Cell"><Data ss:Type="String">缺陷记录模板</Data></Cell></Row>
</Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions></Worksheet>

